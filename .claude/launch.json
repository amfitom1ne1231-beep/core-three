{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "corethree",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "corethree-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start:check"
      ],
      "port": 3100
    },
    {
      "name": "corethree-bot",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "bot",
        "run",
        "dev"
      ],
      "port": 8787
    },
    {
      "name": "proto",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4321",
        "--directory",
        "proto"
      ],
      "port": 4321
    }
  ]
}
