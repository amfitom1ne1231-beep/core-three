# Скопировать в .env.local и заполнить. .env.local в репозиторий не попадает.

# Адрес сайта: канонические ссылки, sitemap, Open Graph
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Заявки уходят в сервис бота (bot/, план — BOT.md): он хранит их в своей
# базе и ставит карточку в рабочую группу. Секрет — тот же, что INTAKE_SECRET
# у сервиса (любая длинная случайная строка: openssl rand -hex 32).
# Без них локально форма работает всухую — заявка уходит в лог сервера.
BOT_INTAKE_URL=http://localhost:8787/api/intake/lead
INTAKE_SECRET=

# Запасной путь: если сервис бота недоступен, сайт шлёт заявку прямо
# в рабочую группу. Токен — у @BotFather, chat_id — группа, где бот состоит.
# Заявка, которая дошла хотя бы так, считается принятой.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Если в группе включены темы — номер темы для заявок: среднее число
# в ссылке на любое сообщение этой темы (t.me/c/<группа>/<тема>/<сообщение>).
# Пусто — сообщения идут в общую ветку.
TELEGRAM_THREAD_ID=
# Свой адрес Bot API вместо api.telegram.org — когда с сервера до Telegram
# напрямую не достать (в России он заблокирован). Тот же, что у сервиса бота.
TELEGRAM_API_ROOT=

# Яндекс.Метрика — волна 3. Пока пусто, плашка cookie не показывается
# и скрипт не грузится.
NEXT_PUBLIC_YM_ID=

# Доверять заголовкам прокси (x-real-ip / x-forwarded-for) при
# ограничении частоты заявок. На Vercel не нужно: там свой заголовок,
# который платформа переписывает сама. Ставить 1 только когда перед
# приложением действительно стоит свой прокси, и он сам выставляет
# x-real-ip (на сервере это Caddy — deploy/Caddyfile; docker-compose.yml
# ставит переменную сам). Иначе адрес можно подделать одной строчкой
# и лимита не будет.
TRUST_PROXY=
