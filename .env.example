# Скопировать в .env.local и заполнить. .env.local в репозиторий не попадает.

# Адрес сайта: канонические ссылки, sitemap, Open Graph
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Заявки. Секретный ключ: Supabase → Project Settings → API Keys → Secret keys.
# Без ключей локально форма работает всухую — заявка уходит в лог сервера.
SUPABASE_URL=https://opxqsgzpzncxfohpzakx.supabase.co
SUPABASE_SECRET_KEY=

# Уведомление о каждой заявке в рабочий чат Telegram. Токен — у @BotFather,
# chat_id — личка, группа или канал, где этот бот состоит. Пока пусто,
# заявка уходит только в базу. Если база недоступна, а сообщение дошло,
# заявка всё равно считается принятой.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Яндекс.Метрика — волна 3. Пока пусто, плашка cookie не показывается
# и скрипт не грузится.
NEXT_PUBLIC_YM_ID=

# Доверять заголовкам прокси (x-real-ip / x-forwarded-for) при
# ограничении частоты заявок. На Vercel не нужно: там свой заголовок,
# который платформа переписывает сама. Ставить 1 только когда перед
# приложением действительно стоит свой прокси — например nginx на VPS.
# Иначе адрес можно подделать одной строчкой и лимита не будет.
TRUST_PROXY=
