# Скопировать в bot/.env.local и заполнить. .env.local в репозиторий не попадает.

# Бот: токен от @BotFather. Пусто — бот выключен, сервис принимает заявки в базу.
BOT_TOKEN=
# polling — локально; webhook — на сервере (нужны PUBLIC_URL и WEBHOOK_SECRET)
BOT_MODE=polling
# Публичный адрес сервиса по HTTPS: webhook и мини-приложение (<адрес>/app/).
# Локально пусто; `npm run dev:tunnel` подставляет адрес туннеля сам.
PUBLIC_URL=
WEBHOOK_SECRET=

# Мини-приложение (admin/). В браузере без Telegram: 1 — запросы с этой же
# машины идут от имени первого владельца. В production и при PUBLIC_URL
# не действует. На сервере не ставить.
APP_DEV=
# Куда ведёт «Открыть» под карточкой в группе: chat — в личку бота (работает
# с любым адресом), direct — сразу в приложение (нужен постоянный адрес,
# вписанный у @BotFather как Main Mini App).
MINI_APP_LINK=chat
# Папка собранного приложения. По умолчанию ../admin/dist
ADMIN_DIST=

# Telegram id владельцев через запятую (узнать свой: написать @userinfobot).
# Владельцы входят без приглашения, зовут остальных командой /invite
# и получают вечернюю тревогу. У студии владельцы все трое.
OWNER_TG_IDS=

# Рабочая группа, пока её не задали командой /bind в самой группе.
# id супергруппы начинается с -100. В группе с темами без GROUP_THREAD_ID
# карточки идут в «Общую» тему — лучше /bind внутри темы «Заявки».
GROUP_CHAT_ID=
GROUP_THREAD_ID=

# Тот же секрет, что INTAKE_SECRET у сайта: им подписана каждая заявка.
# Любая длинная случайная строка: openssl rand -hex 32
INTAKE_SECRET=

# База. Пусто — встроенный Postgres (PGlite) в BOT_DATA_DIR: для разработки.
# На сервере — настоящий: postgres://user:pass@db:5432/corethree
DATABASE_URL=
BOT_DATA_DIR=.data/pglite

PORT=8787
SITE_URL=https://corethree.ru

# Рабочее время для сроков по заявкам. Дни: 0 — воскресенье.
WORK_TZ=Europe/Moscow
WORK_DAYS=1,2,3,4,5
WORK_START=10:00
WORK_END=19:00
# Через сколько рабочих минут без «Беру» напомнить группе
SLA_TAKE_MIN=60
# За сколько минут до конца дня проверить, всем ли ответили
SLA_ALARM_BEFORE_END_MIN=60
