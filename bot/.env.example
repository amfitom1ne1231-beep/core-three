# Скопировать в bot/.env.local и заполнить. .env.local в репозиторий не попадает.

# Бот: токен от @BotFather. Пусто — бот выключен, сервис принимает заявки в базу.
BOT_TOKEN=
# polling — локально; webhook — на сервере (нужны PUBLIC_URL и WEBHOOK_SECRET)
BOT_MODE=polling
PUBLIC_URL=
WEBHOOK_SECRET=

# Ваш Telegram id (узнать: написать @userinfobot). Владелец входит без приглашения
# и приглашает остальных командой /invite.
OWNER_TG_ID=

# Тот же секрет, что INTAKE_SECRET у сайта: им подписана каждая заявка.
# Любая длинная случайная строка: openssl rand -hex 32
INTAKE_SECRET=

# База. Пусто — встроенный Postgres (PGlite) в BOT_DATA_DIR: для разработки.
# На сервере — настоящий: postgres://user:pass@db:5432/corethree
DATABASE_URL=
BOT_DATA_DIR=.data/pglite

PORT=8787
SITE_URL=https://corethree.ru

# Рабочее время для сроков по заявкам. Дни: 0 — воскресенье.
WORK_TZ=Europe/Moscow
WORK_DAYS=1,2,3,4,5
WORK_START=10:00
WORK_END=19:00
# Через сколько рабочих минут без «Беру» напомнить группе
SLA_TAKE_MIN=60
# За сколько минут до конца дня проверить, всем ли ответили
SLA_ALARM_BEFORE_END_MIN=60
