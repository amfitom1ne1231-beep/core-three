# Адреса CoreThree. Сертификаты Caddy получает сам, как только записи
# домена у регистратора указывают на этот сервер.

{
	# HTTP/3 выключен намеренно. Браузер, узнав о нём, уходит с HTTP/2
	# на QUIC, а тот по пути до российского сервера идёт с большими
	# потерями: замер 05.10.2026 — 6–12 с на страницу против 2–2,5 с
	# по HTTP/2. Совсем QUIC не отваливается, поэтому сам браузер назад
	# не возвращается.
	servers {
		protocols h1 h2
	}
}

corethree.ru {
	encode zstd gzip
	# браузер запоминает на год, что сюда — только по HTTPS
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy site:3000 {
		# Адрес посетителя для лимита заявок ставит Caddy. Без этой строки
		# заголовок доходил до сайта таким, каким его прислал сам посетитель:
		# менять его в каждом запросе — и лимита нет.
		header_up X-Real-IP {remote_host}
	}
}

www.corethree.ru {
	redir https://corethree.ru{uri} permanent
}

# сервис бота: webhook Telegram (/tg/<секрет>), мини-приложение (/app/), его API
bot.corethree.ru {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy bot:8787
}
