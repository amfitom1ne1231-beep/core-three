# Временный вход, пока домен не подключён: сайт по адресу машины, без HTTPS.
#
# Включается сам: deploy/push.sh берёт этот файл, пока corethree.ru
# не указывает на сервер, и основной Caddyfile — как только указывает.
# Заявки здесь идут открытым текстом, поэтому адрес — только для своей
# проверки, никому не раздавать. Сервис бота наружу в этом режиме закрыт:
# мини-приложению нужен HTTPS.

:80 {
	encode zstd gzip
	# по адресу машины сайт в поиск попасть не должен
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy site:3000 {
		header_up X-Real-IP {remote_host}
	}
}
