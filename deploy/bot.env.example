# Сервис бота на сервере. Скопировать в deploy/bot.env и заполнить.
# BOT_MODE, PUBLIC_URL, SITE_URL и DATABASE_URL задаёт docker-compose.yml.
# Пояснения ко всем полям — bot/.env.example.

BOT_TOKEN=
# любая длинная случайная строка: openssl rand -hex 32
WEBHOOK_SECRET=
INTAKE_SECRET=
SECRETS_KEY=

OWNER_TG_IDS=
GROUP_CHAT_ID=
GROUP_THREAD_ID=

# chat — «Открыть» ведёт в личку бота; direct — сразу в приложение
# (нужен Main Mini App у @BotFather с адресом https://bot.corethree.ru/app/)
MINI_APP_LINK=chat

SHEETS_URL=
SHEETS_SECRET=

WORK_TZ=Europe/Moscow
WORK_DAYS=1,2,3,4,5
WORK_START=10:00
WORK_END=19:00
SLA_TAKE_MIN=60
SLA_ALARM_BEFORE_END_MIN=60
