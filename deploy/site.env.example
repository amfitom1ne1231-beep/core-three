# Сайт на сервере. Скопировать в deploy/site.env и заполнить.
# BOT_INTAKE_URL и TRUST_PROXY задаёт docker-compose.yml.
# SITE_NOINDEX здесь НЕ ставить: он закрывает сайт от поиска (только для превью).

# Тот же секрет, что INTAKE_SECRET в deploy/bot.env
INTAKE_SECRET=

# Запасной путь заявки, если сервис бота недоступен: прямо в группу
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_THREAD_ID=
